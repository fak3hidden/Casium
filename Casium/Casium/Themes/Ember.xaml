<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Ember : warm dark with orange accent -->
    <sys:String x:Key="Theme.Name">Ember</sys:String>
    <sys:String x:Key="Theme.MonacoBase">vs-dark</sys:String>

    <SolidColorBrush x:Key="App.Background"    Color="#141210"/>
    <SolidColorBrush x:Key="App.Surface"       Color="#1B1815"/>
    <SolidColorBrush x:Key="App.SurfaceAlt"    Color="#221E1A"/>
    <SolidColorBrush x:Key="App.SurfaceHover"  Color="#2A2521"/>
    <SolidColorBrush x:Key="App.SurfacePressed" Color="#332D28"/>
    <SolidColorBrush x:Key="App.Border"        Color="#2C2721"/>
    <SolidColorBrush x:Key="App.BorderStrong"  Color="#3E362E"/>
    <SolidColorBrush x:Key="App.Scrim"         Color="#66000000"/>

    <SolidColorBrush x:Key="Text.Primary"      Color="#F3EDE6"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#AFA396"/>
    <SolidColorBrush x:Key="Text.Tertiary"     Color="#75695D"/>
    <SolidColorBrush x:Key="Text.OnAccent"     Color="#1B1410"/>

    <SolidColorBrush x:Key="Accent"            Color="#F59E0B"/>
    <SolidColorBrush x:Key="Accent.Hover"      Color="#FBB233"/>
    <SolidColorBrush x:Key="Accent.Pressed"    Color="#D97706"/>
    <SolidColorBrush x:Key="Accent.Soft"       Color="#2F261B"/>
    <SolidColorBrush x:Key="Accent.Text"       Color="#F59E0B"/>

    <SolidColorBrush x:Key="Status.Ok"         Color="#4ADE80"/>
    <SolidColorBrush x:Key="Status.Warn"       Color="#FBBF24"/>
    <SolidColorBrush x:Key="Status.Err"        Color="#F87171"/>
    <SolidColorBrush x:Key="Status.Idle"       Color="#5C544C"/>

    <SolidColorBrush x:Key="Editor.Background" Color="#171411"/>
    <SolidColorBrush x:Key="Editor.Gutter"     Color="#544A40"/>
    <SolidColorBrush x:Key="Editor.Text"       Color="#EDE6DD"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#1E1A16"/>
    <SolidColorBrush x:Key="Syntax.Comment"    Color="#75695D"/>
    <SolidColorBrush x:Key="Syntax.String"     Color="#A6D189"/>
    <SolidColorBrush x:Key="Syntax.Keyword"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="Syntax.Number"     Color="#F38BA8"/>
    <SolidColorBrush x:Key="Syntax.Builtin"    Color="#89B4FA"/>

    <Color x:Key="Theme.Shadow">#000000</Color>
    <sys:Double x:Key="Theme.ShadowOpacity">0.55</sys:Double>
</ResourceDictionary>
