<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Volt : dark violet (matches the login screen) -->
    <sys:String x:Key="Theme.Name">Volt</sys:String>
    <sys:String x:Key="Theme.MonacoBase">vs-dark</sys:String>

    <SolidColorBrush x:Key="App.Background"    Color="#0B0910"/>
    <SolidColorBrush x:Key="App.Surface"       Color="#130F1C"/>
    <SolidColorBrush x:Key="App.SurfaceAlt"    Color="#171324"/>
    <SolidColorBrush x:Key="App.SurfaceHover"  Color="#1F1930"/>
    <SolidColorBrush x:Key="App.SurfacePressed" Color="#271F3D"/>
    <SolidColorBrush x:Key="App.Border"        Color="#2B2140"/>
    <SolidColorBrush x:Key="App.BorderStrong"  Color="#3D2F5C"/>
    <SolidColorBrush x:Key="App.Scrim"         Color="#80000000"/>

    <SolidColorBrush x:Key="Text.Primary"      Color="#EDE9FE"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#A79FBF"/>
    <SolidColorBrush x:Key="Text.Tertiary"     Color="#6E6587"/>
    <SolidColorBrush x:Key="Text.OnAccent"     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent"            Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Accent.Hover"      Color="#9D74FF"/>
    <SolidColorBrush x:Key="Accent.Pressed"    Color="#6D28E9"/>
    <SolidColorBrush x:Key="Accent.Soft"       Color="#241C3A"/>
    <SolidColorBrush x:Key="Accent.Text"       Color="#A78BFA"/>

    <SolidColorBrush x:Key="Status.Ok"         Color="#4ADE80"/>
    <SolidColorBrush x:Key="Status.Warn"       Color="#FBBF24"/>
    <SolidColorBrush x:Key="Status.Err"        Color="#F87171"/>
    <SolidColorBrush x:Key="Status.Idle"       Color="#5A5470"/>

    <SolidColorBrush x:Key="Editor.Background" Color="#0E0B14"/>
    <SolidColorBrush x:Key="Editor.Gutter"     Color="#4B4460"/>
    <SolidColorBrush x:Key="Editor.Text"       Color="#E6E3F0"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#151021"/>
    <SolidColorBrush x:Key="Syntax.Comment"    Color="#6E6587"/>
    <SolidColorBrush x:Key="Syntax.String"     Color="#9ECE6A"/>
    <SolidColorBrush x:Key="Syntax.Keyword"    Color="#BB9AF7"/>
    <SolidColorBrush x:Key="Syntax.Number"     Color="#FF9E64"/>
    <SolidColorBrush x:Key="Syntax.Builtin"    Color="#7AA2F7"/>

    <Color x:Key="Theme.Shadow">#000000</Color>
    <sys:Double x:Key="Theme.ShadowOpacity">0.6</sys:Double>
</ResourceDictionary>
