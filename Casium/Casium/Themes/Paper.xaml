<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Paper : light grey / white -->
    <sys:String x:Key="Theme.Name">Paper</sys:String>
    <sys:String x:Key="Theme.MonacoBase">vs</sys:String>

    <SolidColorBrush x:Key="App.Background"    Color="#F2F3F5"/>
    <SolidColorBrush x:Key="App.Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.SurfaceAlt"    Color="#F7F8FA"/>
    <SolidColorBrush x:Key="App.SurfaceHover"  Color="#ECEEF1"/>
    <SolidColorBrush x:Key="App.SurfacePressed" Color="#E1E4E8"/>
    <SolidColorBrush x:Key="App.Border"        Color="#E1E4E8"/>
    <SolidColorBrush x:Key="App.BorderStrong"  Color="#C9CED6"/>
    <SolidColorBrush x:Key="App.Scrim"         Color="#14000000"/>

    <SolidColorBrush x:Key="Text.Primary"      Color="#1B1F24"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#5B6472"/>
    <SolidColorBrush x:Key="Text.Tertiary"     Color="#98A1AE"/>
    <SolidColorBrush x:Key="Text.OnAccent"     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Accent"            Color="#2F3541"/>
    <SolidColorBrush x:Key="Accent.Hover"      Color="#1F242D"/>
    <SolidColorBrush x:Key="Accent.Pressed"    Color="#14181F"/>
    <SolidColorBrush x:Key="Accent.Soft"       Color="#E6E8EC"/>
    <SolidColorBrush x:Key="Accent.Text"       Color="#2F3541"/>

    <SolidColorBrush x:Key="Status.Ok"         Color="#1F9D55"/>
    <SolidColorBrush x:Key="Status.Warn"       Color="#D97706"/>
    <SolidColorBrush x:Key="Status.Err"        Color="#DC2626"/>
    <SolidColorBrush x:Key="Status.Idle"       Color="#A3ABB7"/>

    <SolidColorBrush x:Key="Editor.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Editor.Gutter"     Color="#B4BAC4"/>
    <SolidColorBrush x:Key="Editor.Text"       Color="#1B1F24"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Syntax.Comment"    Color="#8B93A1"/>
    <SolidColorBrush x:Key="Syntax.String"     Color="#0F766E"/>
    <SolidColorBrush x:Key="Syntax.Keyword"    Color="#7C3AED"/>
    <SolidColorBrush x:Key="Syntax.Number"     Color="#B45309"/>
    <SolidColorBrush x:Key="Syntax.Builtin"    Color="#1D4ED8"/>

    <Color x:Key="Theme.Shadow">#000000</Color>
    <sys:Double x:Key="Theme.ShadowOpacity">0.16</sys:Double>
</ResourceDictionary>
