<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Graphite : neutral dark -->
    <sys:String x:Key="Theme.Name">Graphite</sys:String>
    <sys:String x:Key="Theme.MonacoBase">vs-dark</sys:String>

    <SolidColorBrush x:Key="App.Background"    Color="#151618"/>
    <SolidColorBrush x:Key="App.Surface"       Color="#1C1D20"/>
    <SolidColorBrush x:Key="App.SurfaceAlt"    Color="#222327"/>
    <SolidColorBrush x:Key="App.SurfaceHover"  Color="#2A2B30"/>
    <SolidColorBrush x:Key="App.SurfacePressed" Color="#333439"/>
    <SolidColorBrush x:Key="App.Border"        Color="#2B2C31"/>
    <SolidColorBrush x:Key="App.BorderStrong"  Color="#3A3B41"/>
    <SolidColorBrush x:Key="App.Scrim"         Color="#66000000"/>

    <SolidColorBrush x:Key="Text.Primary"      Color="#ECEDEF"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#A0A4AC"/>
    <SolidColorBrush x:Key="Text.Tertiary"     Color="#6B7079"/>
    <SolidColorBrush x:Key="Text.OnAccent"     Color="#0F1012"/>

    <SolidColorBrush x:Key="Accent"            Color="#E6E7EA"/>
    <SolidColorBrush x:Key="Accent.Hover"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Pressed"    Color="#CFD1D6"/>
    <SolidColorBrush x:Key="Accent.Soft"       Color="#2A2B30"/>
    <SolidColorBrush x:Key="Accent.Text"       Color="#E6E7EA"/>

    <SolidColorBrush x:Key="Status.Ok"         Color="#4ADE80"/>
    <SolidColorBrush x:Key="Status.Warn"       Color="#FBBF24"/>
    <SolidColorBrush x:Key="Status.Err"        Color="#F87171"/>
    <SolidColorBrush x:Key="Status.Idle"       Color="#5C6068"/>

    <SolidColorBrush x:Key="Editor.Background" Color="#18191C"/>
    <SolidColorBrush x:Key="Editor.Gutter"     Color="#4B4F57"/>
    <SolidColorBrush x:Key="Editor.Text"       Color="#E6E7EA"/>
    <SolidColorBrush x:Key="Editor.LineHighlight" Color="#1F2024"/>
    <SolidColorBrush x:Key="Syntax.Comment"    Color="#6B7079"/>
    <SolidColorBrush x:Key="Syntax.String"     Color="#9ECE6A"/>
    <SolidColorBrush x:Key="Syntax.Keyword"    Color="#C4A7FF"/>
    <SolidColorBrush x:Key="Syntax.Number"     Color="#FF9E64"/>
    <SolidColorBrush x:Key="Syntax.Builtin"    Color="#7AA2F7"/>

    <Color x:Key="Theme.Shadow">#000000</Color>
    <sys:Double x:Key="Theme.ShadowOpacity">0.55</sys:Double>
</ResourceDictionary>
