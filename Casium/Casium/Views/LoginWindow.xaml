<Window x:Class="Casium.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Casium"
        Height="660" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Potassium-style dark palette -->
        <Color x:Key="CardColor">#111117</Color>
        <Color x:Key="StatusBarColor">#0D0D12</Color>
        <Color x:Key="PanelColor">#16161C</Color>
        <Color x:Key="InputColor">#1A1A21</Color>
        <Color x:Key="InputBorderColor">#2A2A35</Color>
        <Color x:Key="InputHoverColor">#52525B</Color>
        <Color x:Key="InputFocusColor">#E4E4E7</Color>
        <Color x:Key="MutedColor">#A1A1AA</Color>
        <Color x:Key="FaintColor">#71717A</Color>
        <Color x:Key="LineColor">#26262E</Color>
        <Color x:Key="GreenColor">#4ADE80</Color>

        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource InputFocusColor}"/>
        <SolidColorBrush x:Key="InputErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>

        <!-- Primary button: white with black text, like Potassium's Execute button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D4D4D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A1A1AA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#71717A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outlined secondary button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#16161C"/>
            <Setter Property="BorderBrush" Value="#2E2E38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C24"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title-bar window buttons -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" BasedOn="{StaticResource TitleBarButton}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small flat button (Show / Hide password) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Card -->
    <Border Margin="12" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="20" Height="22">
                            <Polygon Points="10,1 19,6 19,16 10,21 1,16 1,6"
                                     Stroke="#E4E4E7" StrokeThickness="1.5"/>
                            <TextBlock Text="C" Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Casium" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="v1.0" Foreground="{StaticResource FaintBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Content="—"
                                Style="{StaticResource TitleBarButton}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="✕"
                                Style="{StaticResource TitleBarCloseButton}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Login form -->
            <StackPanel Grid.Row="1" Margin="36,4,36,0">
                <!-- Logo -->
                <Grid Width="76" Height="82" HorizontalAlignment="Center">
                    <Polygon Points="38,2 74,23 74,61 38,80 2,61 2,23"
                             Fill="#16161C" Stroke="#E4E4E7" StrokeThickness="2.5"/>
                    <TextBlock Text="C" Foreground="White" FontSize="30"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="CASIUM" Foreground="White" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="Sign in to continue"
                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,22"/>

                <!-- Error message -->
                <Border x:Name="ErrorBox" Background="#231014"
                        BorderBrush="#7F1D1D" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#FCA5A5"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                <Border x:Name="UsernameBorder" Background="#1A1A21"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                    <TextBox x:Name="UsernameInput"
                             Style="{StaticResource InputBox}"
                             CaretBrush="White"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                             TextChanged="Input_TextChanged"
                             KeyDown="UsernameInput_KeyDown"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <Border x:Name="PasswordBorder" Background="#1A1A21"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource InputBox}"
                                     CaretBrush="White"
                                     GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     KeyUp="PasswordInput_KeyUp"/>
                        <TextBox x:Name="VisiblePasswordInput"
                                 Grid.Column="0"
                                 Style="{StaticResource InputBox}"
                                 CaretBrush="White"
                                 Visibility="Collapsed"
                                 GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                 TextChanged="VisiblePasswordInput_TextChanged"
                                 KeyDown="PasswordBox_KeyDown"/>
                        <Button x:Name="ShowPasswordButton"
                                Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Click="ShowPasswordButton_Click"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                           Foreground="#FBBF24" FontSize="12" Margin="2,6,0,0"
                           Visibility="Collapsed"/>

                <!-- Remember me / Forgot password -->
                <Grid Margin="0,14,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="RememberMeCheckBox"
                              Content="Remember me"
                              FontSize="13" Foreground="#D4D4D8"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13">
                        <Hyperlink Click="ForgotPassword_Click">Forgot password?</Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Sign in -->
                <Button x:Name="LoginButton" Content="SIGN IN"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="LoginButton_Click"/>

                <!-- Get Key / Discord -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GetKeyButton" Grid.Column="0" Content="Get Key"
                            Style="{StaticResource OutlineButton}"
                            Click="GetKeyButton_Click"/>
                    <Button x:Name="DiscordButton" Grid.Column="2" Content="Discord"
                            Style="{StaticResource OutlineButton}"
                            Click="DiscordButton_Click"/>
                </Grid>

                <!-- Demo credentials hint -->
                <Border Background="#14141B" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,16,0,0">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center">
                        <Run Text="Demo access —  Username: "/><Run Text="admin" FontWeight="Bold" Foreground="White"/><Run Text="    Password: "/><Run Text="casium123" FontWeight="Bold" Foreground="White"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#0D0D12"
                    BorderBrush="#232329" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}"/>
                        <TextBlock Text="Ready" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="v1.0" Foreground="{StaticResource FaintBrush}"
                               FontSize="12" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
