<Window x:Class="Casium.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Casium"
        Icon="pack://application:,,,/Casium;component/Assets/casium.ico"
        Height="700" Width="920"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#1B1D26"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Login palette (fixed, independent of app theme) -->
        <SolidColorBrush x:Key="L.Bg"          Color="#1B1D26"/>
        <SolidColorBrush x:Key="L.TitleBar"    Color="#14161D"/>
        <SolidColorBrush x:Key="L.Card"        Color="#262A36"/>
        <SolidColorBrush x:Key="L.CardBorder"  Color="#343948"/>
        <SolidColorBrush x:Key="L.Input"       Color="#0F1116"/>
        <SolidColorBrush x:Key="L.InputBorder" Color="#1E212B"/>
        <SolidColorBrush x:Key="L.Focus"       Color="#7AA2F7"/>
        <SolidColorBrush x:Key="L.Text"        Color="#E6E9F2"/>
        <SolidColorBrush x:Key="L.Muted"       Color="#8C93A8"/>
        <SolidColorBrush x:Key="L.Subtle"      Color="#A9B4D8"/>
        <SolidColorBrush x:Key="L.Accent"      Color="#7AA2F7"/>
        <SolidColorBrush x:Key="L.AccentHover" Color="#8FB1FF"/>
        <SolidColorBrush x:Key="L.AccentText"  Color="#1B1D26"/>
        <SolidColorBrush x:Key="L.Disabled"    Color="#2E3342"/>
        <SolidColorBrush x:Key="L.DisabledText" Color="#6B7288"/>
        <SolidColorBrush x:Key="L.Error"       Color="#F26D78"/>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2E3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5484D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BareBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource L.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource L.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarePassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource L.Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource L.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource L.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource L.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignInButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource L.Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource L.AccentText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource L.AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource L.Disabled}"/>
                    <Setter Property="Foreground" Value="{StaticResource L.DisabledText}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource L.Bg}" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid Background="Transparent" Focusable="True" x:Name="RootFocusTarget" FocusVisualStyle="{x:Null}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource L.TitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Casium;component/Assets/casium.png" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Casium" FontSize="13.5" Foreground="{StaticResource L.Text}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionClose}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Background="Transparent">
                <!-- soft glow behind the card -->
                <Ellipse Width="620" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2A3550" Offset="0"/>
                            <GradientStop Color="#001B1D26" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Card -->
                <Border Width="348" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource L.Card}" BorderBrush="{StaticResource L.CardBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="26,30,26,28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>

                    <StackPanel>
                        <Image Source="pack://application:,,,/Casium;component/Assets/casium.png" Width="52" Height="52"
                               HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Casium" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource L.Text}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Sign in to continue." FontSize="13" Foreground="{StaticResource L.Subtle}"
                                   HorizontalAlignment="Center" Margin="0,6,0,22"/>

                        <!-- Username -->
                        <Border x:Name="UsernameBorder" Background="{StaticResource L.Input}"
                                BorderBrush="{StaticResource L.InputBorder}" BorderThickness="1" CornerRadius="5" Height="40">
                            <Grid Margin="12,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 1,0 12,12 Z M4,21 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,21"
                                      Stroke="{StaticResource L.Muted}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBox x:Name="UsernameInput" Grid.Column="1" Style="{StaticResource BareBox}" Margin="12,0,0,0"
                                         GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                         TextChanged="Input_TextChanged" KeyDown="UsernameInput_KeyDown"/>
                                <TextBlock x:Name="UsernameHint" Grid.Column="1" Text="Username" FontSize="14"
                                           Foreground="{StaticResource L.Muted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Password -->
                        <Border x:Name="PasswordBorder" Background="{StaticResource L.Input}"
                                BorderBrush="{StaticResource L.InputBorder}" BorderThickness="1" CornerRadius="5" Height="40"
                                Margin="0,10,0,0">
                            <Grid Margin="12,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M7,21 A4,4 0 1,0 7,13 A4,4 0 1,0 7,21 Z M9.8,14.2 L20,4 M17,7 L19.5,9.5 M14,10 L16.5,12.5"
                                      Stroke="{StaticResource L.Muted}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <PasswordBox x:Name="PasswordInput" Grid.Column="1" Style="{StaticResource BarePassword}" Margin="12,0,0,0"
                                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                             PasswordChanged="PasswordInput_PasswordChanged"
                                             KeyDown="PasswordBox_KeyDown" KeyUp="PasswordInput_KeyUp"/>
                                <TextBox x:Name="VisiblePasswordInput" Grid.Column="1" Style="{StaticResource BareBox}" Margin="12,0,0,0"
                                         Visibility="Collapsed"
                                         GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                         TextChanged="VisiblePasswordInput_TextChanged"
                                         KeyDown="PasswordBox_KeyDown" KeyUp="PasswordInput_KeyUp"/>
                                <TextBlock x:Name="PasswordHint" Grid.Column="1" Text="Password" FontSize="14"
                                           Foreground="{StaticResource L.Muted}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" IsHitTestVisible="False"/>
                                <Button x:Name="ShowPasswordButton" Grid.Column="2" Style="{StaticResource EyeButton}"
                                        Visibility="Collapsed" Click="ShowPasswordButton_Click" ToolTip="Show password">
                                    <Path x:Name="EyeIcon"
                                          Data="M2,12 C4.5,7 8,4.5 12,4.5 C16,4.5 19.5,7 22,12 C19.5,17 16,19.5 12,19.5 C8,19.5 4.5,17 2,12 Z M12,15.5 A3.5,3.5 0 1,0 12,8.5 A3.5,3.5 0 1,0 12,15.5 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Caps lock -->
                        <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on" FontSize="12"
                                   Foreground="{StaticResource L.Muted}" Margin="2,8,0,0" Visibility="Collapsed"/>

                        <!-- Error -->
                        <StackPanel x:Name="ErrorBox" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                            <Path Data="M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 Z M5.64,5.64 L18.36,18.36"
                                  Stroke="{StaticResource L.Error}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorText" Text="Incorrect username or password." FontSize="13"
                                       Foreground="{StaticResource L.Error}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="260"/>
                        </StackPanel>

                        <!-- Sign in -->
                        <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource SignInButton}"
                                IsEnabled="False" Margin="0,16,0,0" Click="LoginButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
