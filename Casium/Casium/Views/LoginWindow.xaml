<Window x:Class="Casium.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Casium — Sign in"
        Height="620" Width="980"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#E8EDF5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Brand colors -->
        <Color x:Key="PrimaryColor">#4F46E5</Color>
        <Color x:Key="PrimaryDarkColor">#4338CA</Color>
        <Color x:Key="PrimaryDisabledColor">#A5B4FC</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="HeadingBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="InputErrorBrush" Color="#EF4444"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="0.55"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Primary (Login) button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3730A3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A5B4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small flat button (Show / Hide password) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Card -->
    <Border Margin="24" Background="White" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Opacity="0.18" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left : branding panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrandGradient}"
                    CornerRadius="16,0,0,16"
                    Padding="36">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#FFFFFF33">
                            <TextBlock Text="C" Foreground="White" FontSize="24"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Casium" Foreground="White" FontSize="22"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Tagline + highlights -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Casium"
                                   Foreground="White" FontSize="30" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Sign in to pick up right where you left off."
                                   Foreground="#E0E7FF" FontSize="14" Margin="0,10,0,28"
                                   TextWrapping="Wrap"/>
                        <StackPanel>
                            <TextBlock Foreground="White" FontSize="13.5" Margin="0,0,0,12">
                                <Run Text="✓  "/><Run Text="Fast, focused workspace"/>
                            </TextBlock>
                            <TextBlock Foreground="White" FontSize="13.5" Margin="0,0,0,12">
                                <Run Text="✓  "/><Run Text="Your data stays yours"/>
                            </TextBlock>
                            <TextBlock Foreground="White" FontSize="13.5">
                                <Run Text="✓  "/><Run Text="Works on any Windows PC"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Casium · v1.0"
                               Foreground="#C7D2FE" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Right : sign-in form -->
            <Border Grid.Column="1" Background="White" CornerRadius="0,16,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="52,40" MaxWidth="420">
                        <TextBlock Text="Welcome back"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource HeadingBrush}"/>
                        <TextBlock Text="Sign in to continue to Casium."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,28"/>

                        <!-- Error message -->
                        <Border x:Name="ErrorBox" Background="#FEF2F2"
                                BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="#B91C1C"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Username -->
                        <TextBlock Text="Username or email" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="UsernameBorder" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                            <TextBox x:Name="UsernameInput"
                                     Style="{StaticResource InputBox}"
                                     GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                     TextChanged="Input_TextChanged"
                                     KeyDown="UsernameInput_KeyDown"/>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                        <Border x:Name="PasswordBorder" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput"
                                             Style="{StaticResource InputBox}"
                                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                             PasswordChanged="PasswordInput_PasswordChanged"
                                             KeyUp="PasswordInput_KeyUp"/>
                                <TextBox x:Name="VisiblePasswordInput"
                                         Grid.Column="0"
                                         Style="{StaticResource InputBox}"
                                         Visibility="Collapsed"
                                         GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                         TextChanged="VisiblePasswordInput_TextChanged"
                                         KeyDown="PasswordBox_KeyDown"/>
                                <Button x:Name="ShowPasswordButton"
                                        Grid.Column="1" Content="Show"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                        Click="ShowPasswordButton_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CapsLockHint" Text="⚠ Caps Lock is on"
                                   Foreground="#B45309" FontSize="12" Margin="2,6,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Remember me / Forgot password -->
                        <Grid Margin="0,16,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="RememberMeCheckBox"
                                      Content="Remember me"
                                      FontSize="13" Foreground="#334155"
                                      VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <Hyperlink Click="ForgotPassword_Click">Forgot password?</Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- Login -->
                        <Button x:Name="LoginButton" Content="Sign in"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Click="LoginButton_Click"/>

                        <!-- Sign up -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <TextBlock Text="New to Casium? " FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Click="SignUp_Click">Create an account</Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- Demo credentials hint -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="8"
                                Padding="12,10" Margin="0,24,0,0">
                            <TextBlock FontSize="12.5" Foreground="#475569" TextWrapping="Wrap">
                                <Run Text="Demo account —  Username: "/><Run Text="admin" FontWeight="Bold"/><Run Text="    Password: "/><Run Text="casium123" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
