<Window x:Class="Casium.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Casium"
        Height="660" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Volt-style dark palette -->
        <Color x:Key="CardColor">#130F1C</Color>
        <Color x:Key="StatusBarColor">#0E0A16</Color>
        <Color x:Key="PanelColor">#171324</Color>
        <Color x:Key="InputColor">#1B1626</Color>
        <Color x:Key="InputBorderColor">#2B2140</Color>
        <Color x:Key="InputHoverColor">#3D2F5C</Color>
        <Color x:Key="InputFocusColor">#8B5CF6</Color>
        <Color x:Key="MutedColor">#A79FBF</Color>
        <Color x:Key="FaintColor">#6E6587</Color>
        <Color x:Key="LineColor">#2B2140</Color>
        <Color x:Key="GreenColor">#4ADE80</Color>

        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="{StaticResource InputFocusColor}"/>
        <SolidColorBrush x:Key="InputErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#6D28E9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Primary button: purple gradient, like Volt's Execute button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#6E6587"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outlined secondary button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#1B1626"/>
            <Setter Property="BorderBrush" Value="#2B2140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#EDE9FE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#241C33"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D2F5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2140"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title-bar window buttons -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A79FBF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2140"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" BasedOn="{StaticResource TitleBarButton}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small flat button (Show / Hide password) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A79FBF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2140"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Card -->
    <Border Margin="12" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" Foreground="#8B5CF6" FontSize="14"
                                   FontStyle="Italic" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Casium" Foreground="White" FontSize="13"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="v1.0" Foreground="{StaticResource FaintBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Content="—"
                                Style="{StaticResource TitleBarButton}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="✕"
                                Style="{StaticResource TitleBarCloseButton}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Login form -->
            <StackPanel Grid.Row="1" Margin="36,4,36,0">
                <!-- Logo -->
                <Grid Width="76" Height="82" HorizontalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="#8B5CF6" FontSize="58"
                               FontStyle="Italic" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="CASIUM" FontSize="22"
                           FontWeight="Bold" FontStyle="Italic" HorizontalAlignment="Center"
                           Margin="0,12,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#A78BFA" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="Sign in to continue"
                           Foreground="{StaticResource MutedBrush}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,22"/>

                <!-- Error message -->
                <Border x:Name="ErrorBox" Background="#231014"
                        BorderBrush="#7F1D1D" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#FCA5A5"
                               FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                <Border x:Name="UsernameBorder" Background="#1B1626"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                    <TextBox x:Name="UsernameInput"
                             Style="{StaticResource InputBox}"
                             CaretBrush="White"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                             TextChanged="Input_TextChanged"
                             KeyDown="UsernameInput_KeyDown"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <Border x:Name="PasswordBorder" Background="#1B1626"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource InputBox}"
                                     CaretBrush="White"
                                     GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     KeyUp="PasswordInput_KeyUp"/>
                        <TextBox x:Name="VisiblePasswordInput"
                                 Grid.Column="0"
                                 Style="{StaticResource InputBox}"
                                 CaretBrush="White"
                                 Visibility="Collapsed"
                                 GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"
                                 TextChanged="VisiblePasswordInput_TextChanged"
                                 KeyDown="PasswordBox_KeyDown"/>
                        <Button x:Name="ShowPasswordButton"
                                Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Click="ShowPasswordButton_Click"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="CapsLockHint" Text="Caps Lock is on"
                           Foreground="#FBBF24" FontSize="12" Margin="2,6,0,0"
                           Visibility="Collapsed"/>

                <!-- Remember me / Forgot password -->
                <Grid Margin="0,14,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Sign in -->
                <Button x:Name="LoginButton" Content="SIGN IN"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="LoginButton_Click"/>

                <!-- Get Key / Discord -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GetKeyButton" Grid.Column="0" Content="Get Key"
                            Style="{StaticResource OutlineButton}"
                            Click="GetKeyButton_Click" Grid.ColumnSpan="3"/>
                </Grid>

                <!-- Demo credentials hint -->
                <Border Background="#171324" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,16,0,0">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center">
                        <Run Text="Demo access —  Username: "/><Run Text="admin" FontWeight="Bold" Foreground="#EDE9FE"/><Run Text="    Password: "/><Run Text="casium123" FontWeight="Bold" Foreground="#EDE9FE"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#0E0A16"
                    BorderBrush="#2B2140" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" Foreground="{StaticResource FaintBrush}"
                               FontSize="12" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
