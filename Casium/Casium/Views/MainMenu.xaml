<Window x:Class="Casium.Views.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:svc="clr-namespace:Casium.Services"
        mc:Ignorable="d"
        Title="Casium"
        Height="600" Width="910"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource App.Background}"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
        <Style x:Key="GhostButton"  TargetType="Button" BasedOn="{StaticResource Button.Ghost}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}"/>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource App.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Document tab in the top bar -->
        <Style x:Key="DocTab" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="14,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                </Trigger>
                <Trigger Property="svc:NavState.IsActive" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.Background}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Start-page action card -->
        <Style x:Key="StartCard" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource App.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="Padding" Value="16,18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource App.BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Explorer row -->
        <Style x:Key="ExplorerRow" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon buttons that appear when the containing row is hovered -->
        <Style x:Key="HoverActions" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Theme tile -->
        <Style x:Key="ThemeTile" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}"/>
                </Trigger>
                <Trigger Property="svc:NavState.IsActive" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Explorer section header (SCRIPTS / AUTO EXECUTE) -->
        <Style x:Key="ExplorerHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron" Data="M9,6 L15,12 L9,18" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8" Width="9" Height="9" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Casium" FontSize="13.5" Foreground="{DynamicResource Text.Primary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource Button.Caption}" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource Button.Caption}" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource Button.CaptionClose}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Explorer -->
                <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource App.Surface}"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
                    <Grid Margin="10,10,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,2,0,10">
                            <TextBlock Text="Explorer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                            <Button x:Name="CollapseSidebarButton" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right"
                                    Width="26" Height="26" Click="CollapseSidebarButton_Click" ToolTip="Hide explorer">
                                <Path Data="M15,6 L9,12 L15,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardInset}" Height="32" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M15.5,14 L20,18.5 M10,17 A7,7 0 1,0 10,3 A7,7 0 1,0 10,17 Z"
                                      Stroke="{DynamicResource Text.Tertiary}" StrokeThickness="1.8" Width="13" Height="13"
                                      Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="FilterBox" Grid.Column="1" Style="{StaticResource TextBox.Bare}"
                                         FontSize="12.5" Padding="8,0,8,0" TextChanged="FilterBox_TextChanged"/>
                                <TextBlock x:Name="FilterHint" Grid.Column="1" Text="Filter scripts"
                                           Foreground="{DynamicResource Text.Tertiary}" FontSize="12.5"
                                           VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <ToggleButton x:Name="ScriptsHeader" Style="{StaticResource ExplorerHeader}" IsChecked="True"
                                                  Click="ExplorerHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <TextBlock Text="SCRIPTS" FontSize="11" FontWeight="SemiBold"/>
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0" Style="{StaticResource HoverActions}">
                                        <Button Style="{StaticResource Button.Icon}" Width="24" Height="24" Tag="scripts" Click="NewFileInFolder_Click" ToolTip="New script">
                                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource Button.Icon}" Width="24" Height="24" Tag="scripts" Click="OpenFolder_Click" ToolTip="Open folder">
                                            <Path Data="M3,7 V19 A1,1 0 0,0 4,20 H20 A1,1 0 0,0 21,19 V9 A1,1 0 0,0 20,8 H12 L10,6 H4 A1,1 0 0,0 3,7 Z M12,12 V17 M9.5,14.5 H14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="ScriptsList" Margin="4,2,0,6"/>

                                <Grid Margin="0,4,0,0">
                                    <ToggleButton x:Name="AutoExecHeader" Style="{StaticResource ExplorerHeader}" IsChecked="False"
                                                  Click="ExplorerHeader_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <TextBlock Text="AUTO EXECUTE" FontSize="11" FontWeight="SemiBold"/>
                                    </ToggleButton>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0" Style="{StaticResource HoverActions}">
                                        <Button Style="{StaticResource Button.Icon}" Width="24" Height="24" Tag="autoexec" Click="NewFileInFolder_Click" ToolTip="New auto-execute script">
                                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource Button.Icon}" Width="24" Height="24" Tag="autoexec" Click="OpenFolder_Click" ToolTip="Open folder">
                                            <Path Data="M3,7 V19 A1,1 0 0,0 4,20 H20 A1,1 0 0,0 21,19 V9 A1,1 0 0,0 20,8 H12 L10,6 H4 A1,1 0 0,0 3,7 Z M12,12 V17 M9.5,14.5 H14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="AutoExecList" Margin="4,2,0,6" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Main -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab bar -->
                    <Border Grid.Row="0" Background="{DynamicResource App.Surface}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ExpandSidebarButton" Style="{StaticResource Button.Icon}" Width="34" Height="42"
                                    Visibility="Collapsed" Click="CollapseSidebarButton_Click" ToolTip="Show explorer">
                                <Path Data="M9,6 L15,12 L9,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>

                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TabStripPanel" Orientation="Horizontal"/>
                            </ScrollViewer>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0">
                                <Button x:Name="AddTabButton" Style="{StaticResource Button.Icon}" Click="AddTabButton_Click" ToolTip="New script">
                                    <Path Data="M12,5 V19 M5,12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="ExecuteButton" Style="{StaticResource Button.Primary}" Height="30" Padding="12,0"
                                        Margin="6,0,0,0" Click="ExecuteButton_Click" ToolTip="Execute current script (F5)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M8,5 L19,12 L8,19 Z" Fill="{DynamicResource Text.OnAccent}" Width="10" Height="10" Stretch="Uniform"/>
                                        <TextBlock Text="Execute" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="InjectButton" Style="{StaticResource Button.Secondary}" Height="30" Padding="12,0"
                                        Margin="6,0,0,0" Click="InjectButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M10,17 L15,12 L10,7 M15,12 H3 M14,4 H19 A1,1 0 0,1 20,5 V19 A1,1 0 0,1 19,20 H14"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"/>
                                        <TextBlock x:Name="InjectLabel" Text="Attach" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Views -->
                    <Grid Grid.Row="1">

                        <!-- Start -->
                        <ScrollViewer x:Name="StartView" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="30,32,30,30" MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Casium" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock FontSize="13.5" Margin="0,8,0,26">
                                    <Run x:Name="StartUserRun" Text="Signed in as —." Foreground="{DynamicResource Text.Primary}"/>
                                    <Run Text=" "/>
                                    <Run x:Name="StartAttachRun" Text="No client attached." Foreground="{DynamicResource Text.Tertiary}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource StartCard}" Click="AddTabButton_Click">
                                        <StackPanel>
                                            <Path Data="M12,5 V19 M5,12 H19" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"/>
                                            <TextBlock Text="New script" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,14,0,4"/>
                                            <TextBlock Text="Opens an untitled tab with a simple print." FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StartCard}" Click="OpenFileButton_Click">
                                        <StackPanel>
                                            <Path Data="M3,7 V19 A1,1 0 0,0 4,20 H20 A1,1 0 0,0 21,19 V9 A1,1 0 0,0 20,8 H12 L10,6 H4 A1,1 0 0,0 3,7 Z" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Open file" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,14,0,4"/>
                                            <TextBlock Text="Load a .lua file from disk into a new tab." FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StartCard}" Click="OpenSettings_Click">
                                        <StackPanel>
                                            <Path Data="M12,15.5 A3.5,3.5 0 1,0 12,8.5 A3.5,3.5 0 1,0 12,15.5 Z M19.4,15 A1.65,1.65 0 0,0 19.7,16.8 L19.8,16.9 A2,2 0 1,1 17,19.7 L16.9,19.6 A1.65,1.65 0 0,0 15,19.4 A1.65,1.65 0 0,0 14,20.9 V21 A2,2 0 1,1 10,21 V20.9 A1.65,1.65 0 0,0 8.9,19.4 A1.65,1.65 0 0,0 7.1,19.7 L7,19.8 A2,2 0 1,1 4.2,17 L4.3,16.9 A1.65,1.65 0 0,0 4.6,15 A1.65,1.65 0 0,0 3.1,14 H3 A2,2 0 1,1 3,10 H3.1 A1.65,1.65 0 0,0 4.6,8.9 A1.65,1.65 0 0,0 4.3,7.1 L4.2,7 A2,2 0 1,1 7,4.2 L7.1,4.3 A1.65,1.65 0 0,0 8.9,4.6 H9 A1.65,1.65 0 0,0 10,3.1 V3 A2,2 0 1,1 14,3 V3.1 A1.65,1.65 0 0,0 15,4.6 A1.65,1.65 0 0,0 16.8,4.3 L16.9,4.2 A2,2 0 1,1 19.7,7 L19.6,7.1 A1.65,1.65 0 0,0 19.4,8.9 V9 A1.65,1.65 0 0,0 20.9,10 H21 A2,2 0 1,1 21,14 H20.9 A1.65,1.65 0 0,0 19.4,15 Z" Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,14,0,4"/>
                                            <TextBlock Text="Theme, editor and console options." FontSize="12.5" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="RECENT SCRIPTS" Style="{StaticResource Text.Eyebrow}" FontSize="11.5"
                                           Foreground="{DynamicResource Accent.Text}" Margin="0,28,0,10"/>
                                <StackPanel x:Name="RecentList"/>
                                <TextBlock x:Name="RecentEmpty" Text="Scripts you open or save will show up here."
                                           Style="{StaticResource Text.Caption}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Editor -->
                        <Grid x:Name="ExecutorView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ConsoleRow" Height="170" MinHeight="0"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="{DynamicResource Editor.Background}">
                                <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid Width="{Binding ViewportWidth, ElementName=EditorScroll}"
                                          MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GutterColumn" Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LineNumbers" Grid.Column="0"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource Editor.Gutter}" TextAlignment="Right"
                                                   Padding="0,12,12,12"/>
                                        <RichTextBox x:Name="EditorBox" Grid.Column="1"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource Editor.Text}"
                                                     CaretBrush="{DynamicResource Editor.Text}"
                                                     SelectionBrush="{DynamicResource Accent}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="13.5"
                                                     Padding="12,12,16,12"
                                                     SpellCheck.IsEnabled="False"
                                                     AcceptsReturn="True" AcceptsTab="True"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     TextChanged="EditorBox_TextChanged"
                                                     KeyUp="EditorBox_KeyUp"
                                                     PreviewMouseUp="EditorBox_MouseUp"/>
                                    </Grid>
                                </ScrollViewer>
                                <wv2:WebView2 x:Name="MonacoView" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Console header doubles as splitter handle -->
                            <Border Grid.Row="1" Background="{DynamicResource App.Surface}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,1" Height="32">
                                <Grid Margin="6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ConsoleTabButton" Content="Console" Style="{StaticResource Button.Segment}"
                                                svc:NavState.IsActive="True" Click="ConsoleTab_Click"/>
                                        <Button x:Name="OutputTabButton" Content="Output" Style="{StaticResource Button.Segment}" Click="OutputTab_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ClearConsoleButton" Content="Clear" Style="{StaticResource Button.Ghost}" Height="24" Click="ClearConsoleButton_Click"/>
                                        <Button x:Name="ToggleConsoleButton" Style="{StaticResource Button.Icon}" Width="24" Height="24" Click="ToggleConsoleButton_Click" ToolTip="Toggle console">
                                            <Path x:Name="ConsoleChevron" Data="M6,15 L12,9 L18,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <GridSplitter Grid.Row="1" Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Cursor="SizeNS"/>

                            <Grid Grid.Row="2" Background="{DynamicResource App.Surface}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="LogList" Style="{StaticResource ListBox.Plain}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="12,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1.5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Text.Tertiary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="›" Foreground="{DynamicResource Accent.Text}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBox x:Name="CommandInput" Grid.Column="1" Style="{StaticResource TextBox.Bare}"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Height="30"
                                                 Padding="8,0,0,0" KeyDown="CommandInput_KeyDown"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Settings -->
                        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="30,28,30,30" MaxWidth="640" HorizontalAlignment="Left">
                                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                <TextBlock Text="Theme, editor and console options." Style="{StaticResource Text.PageSubtitle}" Margin="0,6,0,24"/>

                                <TextBlock Text="APPEARANCE" Style="{StaticResource Text.Eyebrow}"/>
                                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Theme" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Applied instantly and remembered next launch." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                        <WrapPanel x:Name="ThemePanel"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="EDITOR &amp; CONSOLE" Style="{StaticResource Text.Eyebrow}"/>
                                <Border Style="{StaticResource Card}" Padding="4,2" Margin="0,0,0,20">
                                    <StackPanel x:Name="SettingsPanel"/>
                                </Border>

                                <TextBlock Text="ACCOUNT" Style="{StaticResource Text.Eyebrow}"/>
                                <Border Style="{StaticResource Card}" Padding="16,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="AccountNameText" Text="—" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Casium v1.0" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="LogoutButton" Content="Log out" Style="{StaticResource Button.Secondary}" Height="32"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="LogoutButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource App.Surface}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M8,6 L2,12 L8,18 M16,6 L22,12 L16,18" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"/>
                        <TextBlock x:Name="StatusTabText" Text="Start" Style="{StaticResource Text.Caption}" FontSize="12" Margin="8,0,0,0"/>
                        <TextBlock x:Name="LnColText" Text="" Style="{StaticResource Text.Caption}" FontSize="12" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeStatusText" Text="Paper" Style="{StaticResource Text.Caption}" FontSize="12" Margin="0,0,14,0"/>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Status.Err}"/>
                        <TextBlock x:Name="AttachedText" Text="No client" Style="{StaticResource Text.Caption}" FontSize="12" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
